{
  "name": "sphere-academy",
  "version": "1.0.0",
  "description": "Sphere Academy — Marketing Intern Training Platform by Stratos",
  "private": true,
  "scripts": {
    "sync-web": "node ./scripts/sync-web.js",
    "build": "npm run sync-web && npx cap sync",
    "open:android": "npx cap open android",
    "open:ios": "npx cap open ios",
    "run:android": "npm run build && npx cap run android",
    "run:ios": "npm run build && npx cap run ios"
  },
  "dependencies": {
    "@capacitor/android": "^6.1.0",
    "@capacitor/app": "^6.0.0",
    "@capacitor/camera": "^6.0.0",
    "@capacitor/core": "^6.1.0",
    "@capacitor/ios": "^6.1.0",
    "@capacitor/push-notifications": "^6.0.0",
    "@capacitor/splash-screen": "^6.0.0",
    "@capacitor/status-bar": "^6.0.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^6.1.0"
  }
}
